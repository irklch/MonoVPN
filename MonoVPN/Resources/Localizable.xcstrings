        }
      }
    },
    "privacy.item.traffic": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После подключения весь интернет-трафик устройства передаётся через выбранный сервер и обрабатывается вашим VPN-провайдером. DNS-запросы шифруются и через этот же сервер отправляются в Cloudflare DNS (1.1.1.1)."
          }
        }
      }
    },
