    "privacy.item.client": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Mono VPN — это VPN-клиент. У приложения нет собственных серверов: оно подключается к серверу из вашей подписки."
          }
        }
      }
    },
    "privacy.item.noTracking": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение не использует аналитику, не собирает статистику и не хранит историю посещённых сайтов."
          }
        }
      }
    },
    "privacy.item.storage": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ссылка подписки и параметры серверов хранятся только на этом устройстве — в Связке ключей и в защищённом файле приложения. Они не синхронизируются через iCloud и не переносятся на другие устройства."
          }
        }
      }
    },
    "privacy.item.traffic": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После подключения трафик устройства идёт через выбранный сервер и обрабатывается вашим VPN-провайдером; разработчик Mono VPN его не получает. Локальная сеть работает напрямую, без VPN. Готовая конфигурация провайдера может направлять часть трафика напрямую и использовать свои DNS-серверы. Иначе DNS-запросы через тот же сервер уходят в Cloudflare DNS (1.1.1.1) и Google DNS (8.8.8.8) по DNS-over-HTTPS, а при его недоступности — обычным запросом к Google DNS."
          }
        }
      }
    },
