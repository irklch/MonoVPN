    "privacy.item.client": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Mono VPN — это VPN-клиент. У приложения нет собственных серверов: оно подключается к серверу из вашей подписки."
          }
        }
      }
    },
    "privacy.item.noTracking": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение не использует аналитику, не собирает статистику и не хранит историю посещённых сайтов."
          }
        }
      }
    },
    "privacy.item.storage": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ссылка подписки и параметры серверов хранятся только на этом устройстве, в Связке ключей."
