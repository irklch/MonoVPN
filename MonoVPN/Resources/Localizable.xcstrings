    "licenses.intro": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Mono VPN использует программное обеспечение с открытым исходным кодом: Xray-core и его зависимости. Компоненты не изменены. Ниже — их лицензии, уведомления об авторских правах и ссылки на исходный код использованных версий."
