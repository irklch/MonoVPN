// Mono VPN — single source of truth for identifiers, versions and signing.
//
// After activating your own Apple Developer Program membership:
//   1. Put your personal Team ID into DEVELOPMENT_TEAM below
//      (or pick the team in Xcode → Signing & Capabilities; Xcode writes it per target).
//   2. If any identifier below is taken, change it here — targets, entitlements,
//      Info.plist files and Swift code all read these values.
// Never put an employer / corporate team here.

MONO_DISPLAY_NAME = Mono VPN
MONO_BUNDLE_ID = com.irklch.monovpn
MONO_TUNNEL_BUNDLE_ID = $(MONO_BUNDLE_ID).PacketTunnel
MONO_APP_GROUP = group.com.irklch.monovpn

MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1
IPHONEOS_DEPLOYMENT_TARGET = 17.0

CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM =
